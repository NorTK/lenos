[centos-hyperscale-kernel]
name=CentOS Stream $releasever - Hyperscale Kernel
metalink=https://mirrors.centos.org/metalink?repo=centos-hyperscale-sig-packages-kernel-$stream&arch=$basearch&protocol=https,http
#baseurl=http://mirror.stream.centos.org/SIGs/$stream/hyperscale/$basearch/packages-kernel/
gpgcheck=1
enabled=1
countme=1
priority=50
gpgkey=file:///etc/pki/rpm-gpg/RPM-GPG-KEY-CentOS-SIG-HyperScale

[centos-hyperscale-kernel-debuginfo]
name=CentOS Stream $releasever - Hyperscale Kernel - Debug
metalink=https://mirrors.centos.org/metalink?repo=centos-hyperscale-sig-packages-kernel-debug-$stream&arch=$basearch&protocol=https,http
#baseurl=http://mirror.stream.centos.org/SIGs/$stream/hyperscale/$basearch/packages-kernel/debug/
gpgcheck=1
enabled=0
priority=50
gpgkey=file:///etc/pki/rpm-gpg/RPM-GPG-KEY-CentOS-SIG-HyperScale

[centos-hyperscale-kernel-source]
name=CentOS Stream $releasever - Hyperscale Kernel - Source
metalink=https://mirrors.centos.org/metalink?repo=centos-hyperscale-sig-packages-kernel-source-$stream&arch=source&protocol=https,http
#baseurl=http://mirror.stream.centos.org/SIGs/$stream/hyperscale/source/packages-kernel/
gpgcheck=1
enabled=0
priority=50
gpgkey=file:///etc/pki/rpm-gpg/RPM-GPG-KEY-CentOS-SIG-HyperScale
